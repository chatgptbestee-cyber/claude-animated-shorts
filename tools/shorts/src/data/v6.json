 "phrases": [
  {
   "text": "Es fängt an zu regnen.",
   "s": 0.13,
   "e": 1.36
  },
  {
   "text": "Zwei Paare, nur ein Schirm.",
   "s": 1.36,
   "e": 3.99
  },
  {
   "text": "Beim ersten Paar hält er ihn über sich.",
   "s": 4.39,
   "e": 6.52
  },
  {
   "text": "„Hättest halt selbst einen mitgenommen.“",
   "s": 7.04,
   "e": 8.66
  },
  {
