   "s": 9.03,
   "e": 11.07
  },
  {
   "text": "Er wird nass.",
   "s": 11.47,
   "e": 12.16
  },
  {
   "text": "Sie rückt näher.",
   "s": 12.61,
   "e": 13.54
  },
  {
   "text": "Jetzt passen beide drunter.",
   "s": 13.98,
   "e": 15.32
  },
  {
   "text": "Dann kommt der Sturm.",
   "s": 16.42,
   "e": 17.61
  },
  {
   "text": "Links steht jeder allein da.",
   "s": 18.07,
   "e": 19.66
  },
  {
   "text": "Rechts halten sie den Schirm zu zweit.",
   "s": 20.13,
   "e": 22.09
  },
  {
   "text": "Liebe heißt nicht, trocken zu bleiben.",
   "s": 22.56,
