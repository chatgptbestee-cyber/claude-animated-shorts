 "phrases": [
  {
   "text": "Ihr sitzt im selben Boot.",
   "s": 0.11,
   "e": 1.37
  },
  {
   "text": "Zwei Paare, weit weg vom Ufer.",
   "s": 1.37,
   "e": 4.07
  },
  {
   "text": "Beim ersten Paar rudert nur sie.",
   "s": 4.56,
   "e": 6.46
  },
  {
   "text": "Er schaut aufs Handy.",
   "s": 6.86,
   "e": 7.83
  },
  {
   "text": "„Du machst das doch gut.“",
   "s": 8.42,
   "e": 9.46
  },
  {
   "text": "Das Boot dreht sich im Kreis.",
   "s": 9.95,
   "e": 11.6
  },
  {
   "text": "Beim zweiten Paar hat jeder ein Ruder.",
   "s": 12.06,
   "e": 14.05
  },
  {
   "text": "Ist sie müde, rudert er stärker.",
   "s": 14.49,
   "e": 16.38
  },
  {
   "text": "Dann kommen die Wellen.",
   "s": 17.53,
   "e": 18.72
  },
  {
   "text": "Links treibt das Boot ab.",
   "s": 19.19,
   "e": 20.53
  },
  {
   "text": "Rechts kommen sie an.",
   "s": 21.02,
   "e": 22.06
  },
  {
   "text": "Eine Beziehung kommt nicht voran, wenn nur einer rudert.",
   "s": 22.51,
   "e": 25.29
  },
  {
   "text": "Rudert ihr beide oder nur einer?",
   "s": 25.73,
   "e": 27.63
  },
  {
   "text": "Vergiss nicht…",
   "s": 28.16,
   "e": 28.9
  }
 ],
