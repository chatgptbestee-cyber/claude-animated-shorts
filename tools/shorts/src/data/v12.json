 "phrases": [
  {
   "text": "Dein achtjähriges Ich wäre heute stolz auf dich.",
   "s": 0.05,
   "e": 2.87
  },
  {
   "text": "Du bist jetzt so groß wie die, zu denen es immer hochgeschaut hat.",
