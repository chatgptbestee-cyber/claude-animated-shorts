 "phrases": [
  {
   "text": "Die Musik fängt an.",
   "s": 0.13,
   "e": 1.05
  },
  {
   "text": "Zwei Paare tanzen.",
   "s": 1.05,
   "e": 2.87
  },
  {
   "text": "Beim ersten Paar will jeder führen.",
