 "phrases": [
  {
   "text": "Deine Mathenote wirst du vergessen.",
   "s": 0.05,
   "e": 1.97
  },
  {
   "text": "In zehn Jahren weißt du nicht mehr, was in der Bio-Klausur drankam.",
   "s": 2.42,
   "e": 5.67
  },
  {
   "text": "Aber du weißt noch, wer neben dir saß.",
   "s": 6.03,
   "e": 8.09
  },
  {
   "text": "Wer dir in der Pause die Hälfte von seinem Brötchen gegeben hat.",
   "s": 8.58,
   "e": 11.25
  },
  {
   "text": "Wer so lachen musste, dass ihr beide rausgeflogen seid.",
   "s": 11.48,
   "e": 14.51
  },
  {
   "text": "Wer dir vor der Prüfung geschrieben hat: „Du schaffst das.“",
   "s": 14.84,
   "e": 17.38
  },
  {
   "text": "Die Noten stehen in deinem Zeugnis.",
   "s": 18.33,
   "e": 20.26
  },
  {
   "text": "Die Menschen nicht.",
   "s": 20.81,
   "e": 21.63
  },
  {
   "text": "Die musst du dir selbst merken.",
   "s": 22.17,
   "e": 23.43
  },
  {
   "text": "Und deine Mathenote?",
   "s": 24.03,
   "e": 25.27
  }
 ],
